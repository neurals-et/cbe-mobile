{
  "app_name": "CBE Mobile Banking (Commercial Bank of Ethiopia)",
  "package_name": "com.combanketh.mobilebanking",
  "internal_name": "cbe_mb_next",
  "framework": "Flutter/Dart",
  "base_urls": {
    "api_gateway": "https://mb.cbe.com.et/api",
    "internet_banking": "https://cbeib.cbe.com.et",
    "receipts": "https://mbreciept.cbe.com.et",
    "forex": "https://combanketh.et/cbeapi/daily-exchange-rates/"
  },
  "headers": {
    "X-App-Id": "com.combanketh.mobilebanking",
    "X-App-Platform": "android",
    "X-App-Version": "36",
    "X-App-Device": "Samsung SM-A075F",
    "X-App-Device-Id": "device_uuid_hash",
    "X-Handshake-ID": "handshake_session_id",
    "X-Encrypted-Session": "true",
    "X-2FA-Token": "2fa_session_token",
    "Authorization": "Bearer <access_token>",
    "Content-Type": "application/json",
    "Accept": "application/json"
  },
  "security_controls": {
    "ssl_pinning": "GlobalSign Root CA (assets/certs.ts)",
    "integrity": "libpairipcore.so (Play Integrity)",
    "anti_tamper": "libtoolChecker.so (root/hook detector)",
    "screen_protection": "DETECT_SCREEN_CAPTURE, DETECT_SCREEN_RECORDING"
  },
  "endpoints": {
    "security": {
      "secure_handshake": { "method": "POST", "path": "/api/v1/e2e/secure-handshake" },
      "refresh_token": { "method": "POST", "path": "/v1/auth/refresh-token" }
    },
    "auth": {
      "sign_in_pin": { "method": "POST", "path": "/v1/auth/sign-in/pin" },
      "two_factor_request": { "method": "POST", "path": "/v1/auth/two-factor/request-token" },
      "two_factor_validate": { "method": "POST", "path": "/v1/auth/two-factor/validate" },
      "verify_with_passphrase": { "method": "POST", "path": "/v1/auth/two-factor/verify-token-with-passphrase" },
      "change_pin": { "method": "POST", "path": "/v1/users/change-pin" },
      "change_passphrase": { "method": "POST", "path": "/v1/users/change-passphrase" }
    },
    "accounts": {
      "mine": { "method": "GET", "path": "/v1/accounts/mine" },
      "account_info": { "method": "GET", "path": "/v1/accounts/info/{accountNumber}" },
      "cards_issued": { "method": "GET", "path": "/v1/accounts/card/issued" },
      "card_request": { "method": "POST", "path": "/v1/accounts/card/request" },
      "physical_cards": { "method": "GET", "path": "/v1/customer/cards/physical" },
      "virtual_cards": { "method": "GET", "path": "/v1/customer/cards/virtual" }
    },
    "transfers": {
      "internal_own": { "method": "POST", "path": "/v1/transfers/internal-own" },
      "internal_a2a": { "method": "POST", "path": "/v1/transfers/internal-a2a" },
      "external_bank": { "method": "POST", "path": "/v1/transfers/external-bank" },
      "supported_banks": { "method": "GET", "path": "/v1/transfers/external-bank/supported-banks" },
      "external_account_lookup": { "method": "GET", "path": "/v1/transfers/external-bank/account-info" },
      "qr_transfer": { "method": "POST", "path": "/v1/transfers/qr-transfer" }
    },
    "payments": {
      "merchant_pay": { "method": "POST", "path": "/v1/merchant-payments/pay/customer-initiated" },
      "bill_enquiry": { "method": "GET", "path": "/v1/payment-integrations/enquiry/{billerId}" },
      "bill_pay": { "method": "POST", "path": "/v1/payment-integrations/complete-payment/" },
      "tollroad_recharge": { "method": "POST", "path": "/v1/tollroad/recharge" },
      "tollroad_lookup": { "method": "GET", "path": "/v1/tollroad/vehicles/lookup" }
    },
    "atm_withdrawal": {
      "initiate": { "method": "POST", "path": "/v1/customers/withdrawals/initiate" },
      "history": { "method": "GET", "path": "/v1/customers/withdrawals/history" },
      "cancel": { "method": "POST", "path": "/v1/customers/withdrawals/cancel/{code}" }
    },
    "microloans": {
      "dashboard": { "method": "GET", "path": "/v1/loan/dashboard" },
      "eligibility": { "method": "GET", "path": "/v1/loan/eligibility" },
      "offers": { "method": "GET", "path": "/v1/loan/offers" },
      "request": { "method": "POST", "path": "/v1/loan/request-loan" },
      "repay": { "method": "POST", "path": "/v1/loan/repay-loan" }
    }
  }
}
